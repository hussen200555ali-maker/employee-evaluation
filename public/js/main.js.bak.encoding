  const deleteTemplateButtons = document.querySelectorAll('.js-delete-template');

deleteTemplateButtons.forEach(button => {
    button.addEventListener('click', function(event) {
        event.preventDefault(); // ظ…ظ†ط¹ ط§ظ„ط³ظ„ظˆظƒ ط§ظ„ط§ظپطھط±ط§ط¶ظٹ

        const templateId = this.dataset.id;
        const templateName = this.dataset.name;
        const rootUrl = typeof APP_URL !== 'undefined' ? APP_URL : (typeof BASE_URL !== 'undefined' ? BASE_URL : '');

        if (confirm("هل أنت متأكد من أنك تريد حذف القالب \"" + templateName + "\"؟")) {
            
            // 1. ط¥ظ†ط´ط§ط، ظ†ظ…ظˆط°ط¬ ط¬ط¯ظٹط¯ ظ…ط®طµطµ ظ„ظ‡ط°ظ‡ ط§ظ„ط¹ظ…ظ„ظٹط© ظپظ‚ط·
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `${rootUrl}/templates/delete`; // ط§ط³طھط®ط¯ط§ظ… ط§ظ„ط±ط§ط¨ط· ط§ظ„طµط­ظٹط­
            form.style.display = 'none';

            // 2. ط¥ظ†ط´ط§ط، ط­ظ‚ظ„ ظ…ط®ظپظٹ ط¨ط§ظ„ط§ط³ظ… ط§ظ„طµط­ظٹط­
            const hiddenInput = document.createElement('input');
            hiddenInput.type = 'hidden';
