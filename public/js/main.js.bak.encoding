/**
 * ط¯ط§ظ„ط© ظ…ط³ط§ط¹ط¯ط© ظ„ط¹ط±ط¶ ط±ط³ط§ط¦ظ„ Toast ط¨ط§ط³طھط®ط¯ط§ظ… SweetAlert2.
 * @param {string} type - ظ†ظˆط¹ ط§ظ„ط±ط³ط§ظ„ط© ('success', 'error', 'warning', 'info').
 * @param {string} message - ظ†طµ ط§ظ„ط±ط³ط§ظ„ط© ط§ظ„ط°ظٹ ط³ظٹط¸ظ‡ط±.
 */
function getCsrfToken(){return document.querySelector('meta[name="csrf-token"]')?.content || '';}
function showToast(type, message) {
    const Toast = Swal.mixin({
        toast: true,
        position: 'top-start', // ط³طھط¸ظ‡ط± ظپظٹ ط£ط¹ظ„ظ‰ ط§ظ„ظٹط³ط§ط± (ظ„ط£ظ† ط§ظ„طµظپط­ط© ط¹ط±ط¨ظٹط©)
        showConfirmButton: false,
        timer: 3000, // ظ…ط¯ط© ط¸ظ‡ظˆط± ط§ظ„ط±ط³ط§ظ„ط© ط¨ط§ظ„ظ…ظ„ظ„ظٹ ط«ط§ظ†ظٹط© (3 ط«ظˆط§ظ†ظٹ)
        timerProgressBar: true,
        didOpen: (toast) => {
            toast.addEventListener('mouseenter', Swal.stopTimer);
            toast.addEventListener('mouseleave', Swal.resumeTimer);
        }
    });

    Toast.fire({
        icon: type,
        title: message
    });
}



