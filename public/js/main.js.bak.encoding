  // ظپظٹ ظ…ظ„ظپ: public/js/main.js

/**
 * =================================================================
 * ط¯ط§ظ„ط© ظ…ط³ط§ط¹ط¯ط© ظ„ط¥ظ†ط´ط§ط، ظˆط¥ط±ط³ط§ظ„ ظ†ظ…ظˆط°ط¬ ط§ظ„ط­ط°ظپ (ط§ظ„ظ†ط³ط®ط© ط§ظ„ظ†ظ‡ط§ط¦ظٹط© ظˆط§ظ„ظ…ط¤ظƒط¯ط©)
 * =================================================================
 * @param {string} relativePath - ط§ظ„ظ…ط³ط§ط± ط§ظ„ظ†ط³ط¨ظٹ ظپظ‚ط· (ظ…ط«ط§ظ„: '/employees/delete').
 * @param {number} id - ظ…ط¹ط±ظپ ط§ظ„ط¹ظ†طµط± ط§ظ„ظ…ط±ط§ط¯ ط­ط°ظپظ‡.
 */
function submitDeleteForm(relativePath, id) {
    const form = document.createElement('form');
    form.method = 'POST';
    
    // ===> ط§ظ„ط¥طµظ„ط§ط­ ط§ظ„ط­ط§ط³ظ… ظ‡ظ†ط§ <===
    // ظ†ط³طھط®ط¯ظ… ظ…طھط؛ظٹط± APP_URL ط§ظ„ط¹ط§ظ… ظ„ط¶ظ…ط§ظ† ط¨ظ†ط§ط، ط§ظ„ط±ط§ط¨ط· ط§ظ„طµط­ظٹط­ ط¯ط§ط¦ظ…ظ‹ط§.
    form.action = APP_URL + relativePath;

    const hiddenField = document.createElement('input');
    hiddenField.type = 'hidden';
    hiddenField.name = 'id';
    hiddenField.value = id;
    form.appendChild(hiddenField);
    const csrfTokenField = document.createElement('input'); csrfTokenField.type = 'hidden'; csrfTokenField.name = '_token'; csrfTokenField.value = getCsrfToken(); form.appendChild(csrfTokenField);
    document.body.appendChild(form);
    form.submit();
}

