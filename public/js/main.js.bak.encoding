});
    
    // ==================================================
    //        ظ…ط¹ط§ظ„ط¬ط§طھ ط®ط§طµط© ط¨طµظپط­ط© ط¥ط¯ط§ط±ط© ط§ظ„ظ…ط¹ط§ظٹظٹط±
    // ==================================================
    const criterionFormElement = document.getElementById('criterion-form');
    // ===> ط§ظ„طھط­ظ‚ظ‚ ظ…ظ† ظˆط¬ظˆط¯ ظ†ظ…ظˆط°ط¬ ط§ظ„ظ…ط¹ط§ظٹظٹط± ظپظٹ ط§ظ„طµظپط­ط© ط§ظ„ط­ط§ظ„ظٹط© <===
    if (criterionFormElement) {
        const formTitle = document.getElementById('criterion-form-title');
        const submitBtnText = document.getElementById('criterion-submit-btn-text');
        const cancelBtn = document.getElementById('cancel-edit-btn');
        const criterionIdField = document.getElementById('criterion-id');
        const criterionNameField = document.getElementById('criterion-name');
        const criterionWeightField = document.getElementById('criterion-weight');

        /**
         * ظ…ط¹ط§ظ„ط¬ط© طھط¹ط¯ظٹظ„ ط§ظ„ظ…ط¹ظٹط§ط± (Criterion Edit Handler)
         */
        const editCriterionButtons = document.querySelectorAll('.btn-edit-criterion');
        editCriterionButtons.forEach(button => {
            button.addEventListener('click', function() {
                // 1. ط¬ظ„ط¨ ط§ظ„ط¨ظٹط§ظ†ط§طھ ظ…ظ† ط§ظ„ط²ط± ط§ظ„ط°ظٹ طھظ… ط§ظ„ط¶ط؛ط· ط¹ظ„ظٹظ‡.
                const id = this.dataset.id;
                const name = this.dataset.name;
                const weight = this.dataset.weight;

                // 2. طھط؛ظٹظٹط± ط¹ظ†ظˆط§ظ† ظˆط²ط± ط§ظ„ظ†ظ…ظˆط°ط¬ ظ„ظٹط¹ظƒط³ ظˆط¶ط¹ "ط§ظ„طھط¹ط¯ظٹظ„".
                formTitle.innerHTML = '<i class="fas fa-edit"></i> طھط¹ط¯ظٹظ„ ط§ظ„ظ…ط¹ظٹط§ط±';
                submitBtnText.textContent = 'ط­ظپط¸ ط§ظ„طھط¹ط¯ظٹظ„ط§طھ';
                criterionFormElement.action = '/employee-evaluation/criteria/update'; // طھط؛ظٹظٹط± ظ…ط³ط§ط± ط§ظ„ط¥ط±ط³ط§ظ„
                cancelBtn.style.display = 'inline-block'; // ط¥ط¸ظ‡ط§ط± ط²ط± ط§ظ„ط¥ظ„ط؛ط§ط،

                // 3. ظ…ظ„ط، ط­ظ‚ظˆظ„ ط§ظ„ظ†ظ…ظˆط°ط¬ ط¨ط§ظ„ط¨ظٹط§ظ†ط§طھ ط§ظ„ط­ط§ظ„ظٹط© ظ„ظ„ظ…ط¹ظٹط§ط±.
                criterionIdField.value = id;
                criterionNameField.value = name;
                criterionWeightField.value = weight;

                // 4. ظ†ظ‚ظ„ ط§ظ„طھط±ظƒظٹط² (focus) ط¥ظ„ظ‰ ط£ظˆظ„ ط­ظ‚ظ„ ظپظٹ ط§ظ„ظ†ظ…ظˆط°ط¬.
                criterionNameField.focus();
            });
        });

        /**
         * ظ…ط¹ط§ظ„ط¬ط© ط¥ظ„ط؛ط§ط، ط§ظ„طھط¹ط¯ظٹظ„
         */
        cancelBtn.addEventListener('click', function() {
            // 1. ط¥ط¹ط§ط¯ط© ط§ظ„ظ†ظ…ظˆط°ط¬ ط¥ظ„ظ‰ ظˆط¶ط¹ "ط§ظ„ط¥ط¶ط§ظپط©".
            formTitle.innerHTML = '<i class="fas fa-plus-circle"></i> ط¥ط¶ط§ظپط© ظ…ط¹ظٹط§ط± ط¬ط¯ظٹط¯';
            submitBtnText.textContent = 'ط­ظپط¸ ط§ظ„ظ…ط¹ظٹط§ط±';
            criterionFormElement.action = '/employee-evaluation/criteria'; // ط¥ط¹ط§ط¯ط© ظ…ط³ط§ط± ط§ظ„ط¥ط±ط³ط§ظ„
            cancelBtn.style.display = 'none'; // ط¥ط®ظپط§ط، ط²ط± ط§ظ„ط¥ظ„ط؛ط§ط،

            // 2. طھظپط±ظٹط؛ ط­ظ‚ظˆظ„ ط§ظ„ظ†ظ…ظˆط°ط¬.
            criterionFormElement.reset();
            criterionIdField.value = '';
        });

        /**
         * ظ…ط¹ط§ظ„ط¬ط© ط­ط°ظپ ط§ظ„ظ…ط¹ظٹط§ط± (Criterion Deletion Handler)
         */
        const deleteCriterionButtons = document.querySelectorAll('.btn-delete-criterion');
        deleteCriterionButtons.forEach(button => {
            button.addEventListener('click', function() {
                const id = this.dataset.id;
                const name = this.dataset.name;
                const templateId = criterionFormElement.querySelector('input[name="template_id"]').value;

                if (confirm("هل أنت متأكد من أنك تريد حذف المعيار \"" + name + "\"؟")) {
                    // ظ„ط·ظ„ط¨ ط§ظ„ط­ط°ظپطŒ ط³ظ†ظ†ط´ط¦ ظ†ظ…ظˆط°ط¬ط§ظ‹ ظˆظ†ط±ط³ظ„ظ‡.
                    const form = document.createElement('form');
                    form.method = 'POST';
                    form.action = '/employee-evaluation/criteria/delete';

                    // ط¥ط¶ط§ظپط© ط­ظ‚ظ„ ID ط§ظ„ظ…ط¹ظٹط§ط±.
                    const idField = document.createElement('input');
                    idField.type = 'hidden';
                    idField.name = 'id';
                    idField.value = id;
                    form.appendChild(idField);

                    // ط¥ط¶ط§ظپط© ط­ظ‚ظ„ ID ط§ظ„ظ‚ط§ظ„ط¨ (ظ…ظ‡ظ… ظ„ط¥ط¹ط§ط¯ط© ط§ظ„طھظˆط¬ظٹظ‡).
                    const templateIdField = document.createElement('input');
                    templateIdField.type = 'hidden';
                    templateIdField.name = 'template_id';
                    templateIdField.value = templateId;
                    form.appendChild(templateIdField);
                    const csrf3 = document.createElement('input'); csrf3.type='hidden'; csrf3.name='_token'; csrf3.value=getCsrfToken(); form.appendChild(csrf3);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        });
    }
    
    // ==================================================
    //        ظ…ط¹ط§ظ„ط¬ط§طھ ط®ط§طµط© ط¨طµظپط­ط© ط¥ط¯ط§ط±ط© ط§ظ„ط£ظ‚ط³ط§ظ…
    // ==================================================
    const sectionForm = document.getElementById('section-form');
    if (sectionForm) {
        const inputTypeSelect = document.getElementById('input-type');
        const numericOptions = document.getElementById('numeric-options');
        const choiceOptions = document.getElementById('choice-options');

        function toggleSectionOptions() {
            const selectedType = inputTypeSelect.value;
            
            // ط¥ط®ظپط§ط، ظƒظ„ ط§ظ„ط­ظ‚ظˆظ„ ط§ظ„ط¯ظٹظ†ط§ظ…ظٹظƒظٹط© ط£ظˆظ„ط§ظ‹
            numericOptions.style.display = 'none';
            choiceOptions.style.display = 'none';

            // ط¥ط¸ظ‡ط§ط± ط§ظ„ط­ظ‚ظ„ ط§ظ„ظ…ظ†ط§ط³ط¨ ط¨ظ†ط§ط،ظ‹ ط¹ظ„ظ‰ ط§ظ„ط§ط®طھظٹط§ط±
            if (selectedType === 'numeric') {
                numericOptions.style.display = 'block';
            } else if (selectedType === 'single_choice' || selectedType === 'multi_choice') {
                choiceOptions.style.display = 'block';
            }
        }

        // ط§ط³طھط¯ط¹ط§ط، ط§ظ„ط¯ط§ظ„ط© ط¹ظ†ط¯ طھط­ظ…ظٹظ„ ط§ظ„طµظپط­ط© ظ„طھط­ط¯ظٹط¯ ط§ظ„ط­ط§ظ„ط© ط§ظ„ط£ظˆظ„ظٹط©
        toggleSectionOptions();
        // ط§ط³طھط¯ط¹ط§ط، ط§ظ„ط¯ط§ظ„ط© ط¹ظ†ط¯ ظƒظ„ طھط؛ظٹظٹط± ظپظٹ ط§ظ„ظ‚ط§ط¦ظ…ط© ط§ظ„ظ…ظ†ط³ط¯ظ„ط©
        inputTypeSelect.addEventListener('change', toggleSectionOptions);
    }

      // ==================================================
    //        ظ…ط¹ط§ظ„ط¬ط§طھ ط®ط§طµط© ط¨طµظپط­ط© ط¥ط¯ط§ط±ط© ط§ظ„ط£ظ‚ط³ط§ظ…
    // ==================================================
    const sectionFormElement = document.getElementById('section-form');
    if (sectionFormElement) {
        const formTitle = sectionFormElement.parentElement.previousElementSibling.querySelector('h3');
        const submitBtn = sectionFormElement.querySelector('button[type="submit"]');
        const cancelBtn = document.createElement('button'); // ط³ظ†ظ†ط´ط¦ ط²ط± ط§ظ„ط¥ظ„ط؛ط§ط، ط¯ظٹظ†ط§ظ…ظٹظƒظٹط§ظ‹
        cancelBtn.type = 'button';
        cancelBtn.className = 'btn btn-secondary';
        cancelBtn.textContent = 'ط¥ظ„ط؛ط§ط، ط§ظ„طھط¹ط¯ظٹظ„';
        cancelBtn.style.display = 'none';
        submitBtn.parentElement.appendChild(cancelBtn);

        const sectionIdField = document.createElement('input');
        sectionIdField.type = 'hidden';
        sectionIdField.name = 'id';
        sectionFormElement.prepend(sectionIdField);

        const inputTypeSelect = document.getElementById('input-type');
        const numericOptions = document.getElementById('numeric-options');
        const choiceOptions = document.getElementById('choice-options');

        function toggleSectionOptions() { /* ... (ط§ظ„ط¯ط§ظ„ط© طھط¨ظ‚ظ‰ ظƒظ…ط§ ظ‡ظٹ) ... */ }
        toggleSectionOptions();
        inputTypeSelect.addEventListener('change', toggleSectionOptions);

        // ===> ظ…ظ†ط·ظ‚ ط§ظ„طھط¹ط¯ظٹظ„ ط§ظ„ط¬ط¯ظٹط¯ ظ‡ظ†ط§ <===
        const editSectionButtons = document.querySelectorAll('.btn-edit-section');
        editSectionButtons.forEach(button => {
            button.addEventListener('click', function() {
                const data = this.dataset;

                // 1. طھط؛ظٹظٹط± ط§ظ„ظ†ظ…ظˆط°ط¬ ط¥ظ„ظ‰ ظˆط¶ط¹ "ط§ظ„طھط¹ط¯ظٹظ„"
                formTitle.innerHTML = '<i class="fas fa-edit"></i> طھط¹ط¯ظٹظ„ ط§ظ„ظ‚ط³ظ…';
                submitBtn.innerHTML = '<i class="fas fa-save"></i> ط­ظپط¸ ط§ظ„طھط¹ط¯ظٹظ„ط§طھ';
                sectionFormElement.action = '/employee-evaluation/sections/update';
                cancelBtn.style.display = 'inline-block';

                // 2. ظ…ظ„ط، ط­ظ‚ظˆظ„ ط§ظ„ظ†ظ…ظˆط°ط¬ ط¨ط§ظ„ط¨ظٹط§ظ†ط§طھ
                sectionIdField.value = data.id;
                sectionFormElement.querySelector('#section-name').value = data.name;
                sectionFormElement.querySelector('#input-type').value = data.inputType;
                sectionFormElement.querySelector('#max-value').value = data.maxValue;
                sectionFormElement.querySelector('#options-text').value = data.options;
                sectionFormElement.querySelector('#section-weight').value = data.weight;
                sectionFormElement.querySelector('#has_notes').checked = (data.hasNotes == '1');
                sectionFormElement.querySelector('#notes_required').checked = (data.notesRequired == '1');

                // 3. طھط­ط¯ظٹط« ط§ظ„ط­ظ‚ظˆظ„ ط§ظ„ط¯ظٹظ†ط§ظ…ظٹظƒظٹط©
                toggleSectionOptions();
                
                // 4. ط§ظ„ط§ظ†طھظ‚ط§ظ„ ط¥ظ„ظ‰ ط§ظ„ظ†ظ…ظˆط°ط¬
                sectionFormElement.scrollIntoView({ behavior: 'smooth' });
            });
        });

        // ===> ظ…ظ†ط·ظ‚ ط¥ظ„ط؛ط§ط، ط§ظ„طھط¹ط¯ظٹظ„ <===
        cancelBtn.addEventListener('click', function() {
            formTitle.innerHTML = '<i class="fas fa-plus-circle"></i> ط¥ط¶ط§ظپط© ظ‚ط³ظ… ط¬ط¯ظٹط¯';
            submitBtn.innerHTML = '<i class="fas fa-save"></i> ط­ظپط¸ ط§ظ„ظ‚ط³ظ…';
            sectionFormElement.action = '/employee-evaluation/sections';
            cancelBtn.style.display = 'none';
            sectionFormElement.reset();
            sectionIdField.value = '';
            toggleSectionOptions();
        });
    }
        // ==================================================
    //        ظ…ط¹ط§ظ„ط¬ط§طھ ط®ط§طµط© ط¨طµظپط­ط© ط¥ط¯ط§ط±ط© ط§ظ„ظ…ط³طھط®ط¯ظ…ظٹظ†
    // ==================================================
    const editUserRoleModalElement = document.getElementById('editUserRoleModal');
    // ط§ظ„طھط­ظ‚ظ‚ ظ…ظ† ظˆط¬ظˆط¯ ط§ظ„ظ†ط§ظپط°ط© ط§ظ„ظ…ظ†ط¨ط«ظ‚ط© ظپظٹ ط§ظ„طµظپط­ط© ط§ظ„ط­ط§ظ„ظٹط©
    if (editUserRoleModalElement) {
        // ط¥ظ†ط´ط§ط، ظƒط§ط¦ظ† Modal ظ…ظ† Bootstrap ظ„ظ„طھط­ظƒظ… ظپظٹ ط§ظ„ظ†ط§ظپط°ط©
        const editUserRoleModal = new bootstrap.Modal(editUserRoleModalElement);
        // ط§ط³طھظ‡ط¯ط§ظپ ظƒظ„ ط£ط²ط±ط§ط± "طھط؛ظٹظٹط± ط§ظ„ط¯ظˆط±"
        const editUserRoleButtons = document.querySelectorAll('.js-edit-user-role');
        // ط§ط³طھظ‡ط¯ط§ظپ ظ†ظ…ظˆط°ط¬ ط§ظ„طھط¹ط¯ظٹظ„
        const editUserRoleForm = document.getElementById('editUserRoleForm');

        // ط¥ط¶ط§ظپط© ظ…ط³طھظ…ط¹ ط­ط¯ط« ظ„ظƒظ„ ط²ط±
        editUserRoleButtons.forEach(button => {
            button.addEventListener('click', function() {
                // 1. ط¬ظ„ط¨ ط§ظ„ط¨ظٹط§ظ†ط§طھ ظ…ظ† data attributes ط§ظ„ط®ط§طµط© ط¨ط§ظ„ط²ط± ط§ظ„ط°ظٹ طھظ… ط§ظ„ط¶ط؛ط· ط¹ظ„ظٹظ‡
                const userId = this.dataset.userId;
                const username = this.dataset.username;
                const currentRoleId = this.dataset.currentRoleId;

                // 2. ظ…ظ„ط، ط­ظ‚ظˆظ„ ط§ظ„ظ†ظ…ظˆط°ط¬ ظپظٹ ط§ظ„ظ†ط§ظپط°ط© ط§ظ„ظ…ظ†ط¨ط«ظ‚ط© ط¨ط§ظ„ط¨ظٹط§ظ†ط§طھ
                editUserRoleForm.querySelector('#edit-user-id').value = userId;
                editUserRoleForm.querySelector('#username-placeholder').textContent = username;
                editUserRoleForm.querySelector('#edit-role-id').value = currentRoleId;

                // 3. ظپطھط­ ط§ظ„ظ†ط§ظپط°ط© ط§ظ„ظ…ظ†ط¨ط«ظ‚ط©
                editUserRoleModal.show();
            });
        });
    }

    // ==================================================
    //        ظ…ط¹ط§ظ„ط¬ط§طھ ط®ط§طµط© ط¨طµظپط­ط© ط¥ط¯ط§ط±ط© ط§ظ„ط£ط¯ظˆط§ط± ظˆط§ظ„طµظ„ط§ط­ظٹط§طھ
    // ==================================================
    
    // ط§ط³طھظ‡ط¯ط§ظپ ظƒظ„ ظ…ط±ط¨ط¹ط§طھ ط§ظ„ط§ط®طھظٹط§ط± ط§ظ„طھظٹ ظ„ظ‡ط§ ط§ظ„ظƒظ„ط§ط³ 'permission-checkbox'
    const permissionCheckboxes = document.querySelectorAll('.permission-checkbox');

permissionCheckboxes.forEach(checkbox => {
    checkbox.addEventListener('change', function() {
        const roleId = this.closest('.permission-form').dataset.roleId;
        const permissionId = this.value;
        const isChecked = this.checked;

        const label = this.nextElementSibling;
        const spinner = document.createElement('span');
        spinner.className = 'spinner-border spinner-border-sm ms-2';
        label.appendChild(spinner);
        this.disabled = true;

        fetch('/employee-evaluation/admin/roles/update-permission', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json',
                'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
            },
            body: JSON.stringify({
                role_id: roleId,
                permission_id: permissionId,
                is_checked: isChecked
            })
        })
        .then(response => {
            // ط¯ط§ط¦ظ…ط§ظ‹ ظ‚ظ… ط¨ط¥ط²ط§ظ„ط© ظ…ط¤ط´ط± ط§ظ„طھط­ظ…ظٹظ„ ظˆط¥ط¹ط§ط¯ط© طھظپط¹ظٹظ„ ط§ظ„ظ…ط±ط¨ط¹
            label.removeChild(spinner);
            this.disabled = false;
            
            // ط¥ط°ط§ ظ„ظ… طھظƒظ† ط§ظ„ط§ط³طھط¬ط§ط¨ط© ظ†ط§ط¬ط­ط©طŒ ط§ط¹ط±ط¶ ط±ط³ط§ظ„ط© ط®ط·ط£ ظˆط£ط±ط¬ط¹ ط§ظ„ظ…ط±ط¨ط¹ ظ„ط­ط§ظ„طھظ‡ ط§ظ„ط³ط§ط¨ظ‚ط©
            if (!response.ok) {
                this.checked = !isChecked; // ط¥ط¹ط§ط¯ط© ط§ظ„ظ…ط±ط¨ط¹ ظ„ط­ط§ظ„طھظ‡ ط§ظ„ط£طµظ„ظٹط©
                // ط§ط³طھط¯ط¹ط§ط، ط¯ط§ظ„ط© ط§ظ„ظ€ Toast ظ„ط¹ط±ط¶ ط§ظ„ط®ط·ط£
                showToast('error', 'ظپط´ظ„ ط­ظپط¸ ط§ظ„طھط؛ظٹظٹط±!');
                // ط¥ظٹظ‚ط§ظپ ط³ظ„ط³ظ„ط© ط§ظ„ظ€ .then() ظ„ط£ظ†ظ†ط§ ظ„ط§ ظ†ط±ظٹط¯ ظ…ط¹ط§ظ„ط¬ط© JSON ط؛ظٹط± ظ…ظˆط¬ظˆط¯
                throw new Error('Server responded with an error.');
            }
            return response.json();
        })
        .then(data => {
            // ط¥ط°ط§ ظ†ط¬ط­ ط§ظ„ط·ظ„ط¨طŒ ط§ط³طھط¯ط¹ط§ط، ط¯ط§ظ„ط© ط§ظ„ظ€ Toast ظ„ط¹ط±ط¶ ط±ط³ط§ظ„ط© ط§ظ„ظ†ط¬ط§ط­
            if (data.success) {
                showToast('success', 'طھظ… ط­ظپط¸ ط§ظ„طھط؛ظٹظٹط±');
            }
        })
        .catch(error => {
            // ظ‡ط°ط§ ط§ظ„ط¬ط²ط، ط³ظٹط¹ظ…ظ„ ظپظ‚ط· ظپظٹ ط­ط§ظ„ط© ظپط´ظ„ ط§ظ„ط´ط¨ظƒط© ط£ظˆ ط¥ط°ط§ ط£ظˆظ‚ظپظ†ط§ ط§ظ„ط³ظ„ط³ظ„ط© ظٹط¯ظˆظٹط§ظ‹
            console.error('Fetch Error:', error);
            // ظ†طھط£ظƒط¯ ظ…ظ† ط£ظ†ظ†ط§ ظ„ط§ ظ†ط¹ط±ط¶ ط±ط³ط§ظ„ط© ط®ط·ط£ ظ…ط±طھظٹظ†
            if (error.message !== 'Server responded with an error.') {
                showToast('error', 'ظپط´ظ„ ط§ظ„ط§طھطµط§ظ„ ط¨ط§ظ„ط®ط§ط¯ظ….');
            }
        });
    });
    });

    // ظپظٹ ظ…ظ„ظپ /public/js/main.js ط¯ط§ط®ظ„ DOMContentLoaded

    // ... (ط¨ط¹ط¯ ظƒظˆط¯ ظ…ط¹ط§ظ„ط¬ط© طµظ„ط§ط­ظٹط§طھ ط§ظ„ط£ط¯ظˆط§ط±)

    // ==================================================
    //        ظ…ط¹ط§ظ„ط¬ط§طھ طھط¹ط¯ظٹظ„ ظˆط­ط°ظپ ط§ظ„ط£ط¯ظˆط§ط±
    // ==================================================
    const editRoleModalElement = document.getElementById('editRoleModal');
    if (editRoleModalElement) {
        const editRoleModal = new bootstrap.Modal(editRoleModalElement);
        const editRoleForm = document.getElementById('editRoleForm');

        // ظ…ط¹ط§ظ„ط¬ ظپطھط­ ظ†ط§ظپط°ط© ط§ظ„طھط¹ط¯ظٹظ„
        document.querySelectorAll('.js-edit-role').forEach(button => {
            button.addEventListener('click', function() {
                const id = this.dataset.id;
                const name = this.dataset.name;
                const description = this.dataset.description;

                editRoleForm.querySelector('#edit-id').value = id;
                editRoleForm.querySelector('#edit-name').value = name;
                editRoleForm.querySelector('#edit-description').value = description;

                editRoleModal.show();
            });
        });
    }

    // ظ…ط¹ط§ظ„ط¬ ط²ط± ط§ظ„ط­ط°ظپ
    document.querySelectorAll('.js-delete-role').forEach(button => {
        button.addEventListener('click', function() {
            const roleId = this.dataset.id;
            const roleName = this.dataset.name;

            Swal.fire({
                title: "هل أنت متأكد؟",
                text: "سيتم حذف الدور \"" + roleName + "\" بشكل نهائي!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'نعم، احذفه!',
                cancelButtonText: 'إلغاء'
            }).then((result) => {
                if (result.isConfirmed) {
                    // ط¥ط°ط§ ط£ظƒط¯ ط§ظ„ظ…ط³طھط®ط¯ظ…طŒ ظ‚ظ… ط¨ط¥ظ†ط´ط§ط، ظپظˆط±ظ… ظˆط¥ط±ط³ط§ظ„ظ‡
                    const form = document.createElement('form');
                    form.method = 'POST';
                  form.action = '/employee-evaluation/admin/roles/delete';
                    
                    const hiddenField = document.createElement('input');
                    hiddenField.type = 'hidden';
                    hiddenField.name = 'id';
                    hiddenField.value = roleId;
                    form.appendChild(hiddenField);
                    const csrf4 = document.createElement('input'); csrf4.type='hidden'; csrf4.name='_token'; csrf4.value=getCsrfToken(); form.appendChild(csrf4);
                    document.body.appendChild(form);
                    form.submit();
                }
            });
        });
    });
// ==================================================
//        ظ…ط¹ط§ظ„ط¬ طھط؛ظٹظٹط± ط­ط§ظ„ط© ط§ظ„ظ…ط³طھط®ط¯ظ… (طھظپط¹ظٹظ„/طھط¹ظ„ظٹظ‚)
// ==================================================
document.querySelectorAll('.js-toggle-status').forEach(button => {
    button.addEventListener('click', function() {
        const userId = this.dataset.userId;
        const username = this.dataset.username;
        const isActivating = this.classList.contains('btn-view');

        const actionText = isActivating ? 'تفعيل' : 'تعطيل';
        const confirmButtonText = isActivating ? 'نعم، قم بالتفعيل' : 'نعم، قم بالتعطيل';

        Swal.fire({
            title: "هل أنت متأكد؟",
            text: "سيتم " + actionText + " حساب المستخدم \"" + username + "\".",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: isActivating ? '#28a745' : '#d33',
            confirmButtonText: confirmButtonText,
            cancelButtonText: 'إلغاء'
        }).then((result) => {
            if (result.isConfirmed) {
                // ط¥ط±ط³ط§ظ„ ط§ظ„ط·ظ„ط¨ ط¹ط¨ط± AJAX
                fetch('/employee-evaluation/admin/users/toggle-status', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || ''
                    },
                    body: JSON.stringify({ user_id: userId })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast('success', data.message);
                        // ط¥ط¹ط§ط¯ط© طھط­ظ…ظٹظ„ ط§ظ„طµظپط­ط© ظ„ط¹ط±ط¶ ط§ظ„طھط؛ظٹظٹط±ط§طھ (ط£ط¨ط³ط· ط·ط±ظٹظ‚ط©)
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast('error', data.message || 'ط­ط¯ط« ط®ط·ط£ ظ…ط§.');
                    }
                })
                .catch(err => {
                    showToast('error', 'ظپط´ظ„ ط§ظ„ط§طھطµط§ظ„ ط¨ط§ظ„ط®ط§ط¯ظ….');
                    console.error(err);
                });
            }
        });
    });
});


