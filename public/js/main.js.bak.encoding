function confirmDelete(event, itemName = 'ظ‡ط°ط§ ط§ظ„ط¹ظ†طµط±') {
    event.preventDefault(); // ظ…ظ†ط¹ ط¥ط±ط³ط§ظ„ ط§ظ„ظ†ظ…ظˆط°ط¬ ظپظˆط±ط§ظ‹
    const form = event.target;

    Swal.fire({
        title: 'ظ‡ظ„ ط£ظ†طھ ظ…طھط£ظƒط¯طں',
        text: `ط³ظٹطھظ… ط­ط°ظپ ${itemName} ط¨ط´ظƒظ„ ظ†ظ‡ط§ط¦ظٹ! ظ„ط§ ظٹظ…ظƒظ† ط§ظ„طھط±ط§ط¬ط¹ ط¹ظ† ظ‡ط°ط§ ط§ظ„ط¥ط¬ط±ط§ط،.`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'ظ†ط¹ظ…طŒ ظ‚ظ… ط¨ط§ظ„ط­ط°ظپ!',
        cancelButtonText: 'ط¥ظ„ط؛ط§ط،'
    }).then((result) => {
        if (result.isConfirmed) {
            form.submit(); // ط¥ط°ط§ ط£ظƒط¯ ط§ظ„ظ…ط³طھط®ط¯ظ…طŒ ظ‚ظ… ط¨ط¥ط±ط³ط§ظ„ ط§ظ„ظ†ظ…ظˆط°ط¬
        }
    });
}
function confirmReopen(event) {
    event.preventDefault();
    const form = event.target;

    Swal.fire({
        title: 'ط¥ط¹ط§ط¯ط© ظپطھط­ ط§ظ„طھظ‚ظٹظٹظ…طں',
        text: 'ط³ظٹطھظ… طھط؛ظٹظٹط± ط­ط§ظ„ط© ط§ظ„طھظ‚ظٹظٹظ… ط¥ظ„ظ‰ "ظ…ط³ظˆط¯ط©" ظˆط³ظٹطھظ… طھظˆط¬ظٹظ‡ظƒ ظ„طµظپط­ط© ط§ظ„طھط¹ط¯ظٹظ„. ظ‡ظ„ ط£ظ†طھ ظ…طھط£ظƒط¯طں',
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#3085d6',
        cancelButtonColor: '#6c757d',
        confirmButtonText: 'ظ†ط¹ظ…طŒ ط£ط¹ط¯ ط§ظ„ظپطھط­!',
        cancelButtonText: 'ط¥ظ„ط؛ط§ط،'
    }).then((result) => {
        if (result.isConfirmed) {
            form.submit();
        }
    });
}

// public/js/main.js

document.addEventListener('DOMContentLoaded', function() {
    // ط§ظ„طھط­ظ‚ظ‚ ظ…ظ† ط£ظ†ظ†ط§ ظپظٹ طµظپط­ط© ط§ظ„طھظ‚ظٹظٹظ…
    const evaluationLayout = document.querySelector('.evaluation-layout');
    if (!evaluationLayout) return;

    const sidebarLinks = document.querySelectorAll('#criteria-navigation a');
    const criteriaSections = document.querySelectorAll('.criterion-accordion .accordion-item');

    // 1. ط§ظ„طھظ…ط±ظٹط± ط§ظ„ط³ظ„ط³ ط¹ظ†ط¯ ط§ظ„ظ†ظ‚ط± ط¹ظ„ظ‰ ط±ظˆط§ط¨ط· ط§ظ„ط´ط±ظٹط· ط§ظ„ط¬ط§ظ†ط¨ظٹ
    sidebarLinks.forEach(link => {
        link.addEventListener('click', function(e) {
            e.preventDefault();
            const targetId = this.getAttribute('href');
            const targetElement = document.querySelector(targetId);
            if (targetElement) {
                // ط­ط³ط§ط¨ ط¥ط²ط§ط­ط© ط§ظ„ظ‡ظٹط¯ط± ط§ظ„ط±ط¦ظٹط³ظٹ ط¥ط°ط§ ظƒط§ظ† ظ„ط¯ظٹظƒ ظ‡ظٹط¯ط± ط«ط§ط¨طھ
                const offsetTop = targetElement.getBoundingClientRect().top + window.pageYOffset - 80; // 80px ظƒط¥ط²ط§ط­ط©
                window.scrollTo({
                    top: offsetTop,
                    behavior: 'smooth'
                });
            }
        });
    });

    // 2. طھط­ط¯ظٹط« ط§ظ„ط±ط§ط¨ط· ط§ظ„ظ†ط´ط· ظپظٹ ط§ظ„ط´ط±ظٹط· ط§ظ„ط¬ط§ظ†ط¨ظٹ ط£ط«ظ†ط§ط، ط§ظ„طھظ…ط±ظٹط±
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            const id = entry.target.getAttribute('id');
            const navLink = document.querySelector(`#criteria-navigation a[href="#${id}"]`);
            
            if (entry.isIntersecting) {
                // ط¥ط²ط§ظ„ط© 'active' ظ…ظ† ط¬ظ…ظٹط¹ ط§ظ„ط±ظˆط§ط¨ط·
                sidebarLinks.forEach(link => link.classList.remove('active'));
                // ط¥ط¶ط§ظپط© 'active' ط¥ظ„ظ‰ ط§ظ„ط±ط§ط¨ط· ط§ظ„ط­ط§ظ„ظٹ
                if(navLink) navLink.classList.add('active');
            }
        });
    }, { rootMargin: "-40% 0px -60% 0px" }); // ظٹط­ط¯ط¯ ظ…طھظ‰ ظٹط¹طھط¨ط± ط§ظ„ط¹ظ†طµط± "ظ…ط±ط¦ظٹط§ظ‹"

    criteriaSections.forEach(section => {
        observer.observe(section);
    });
});