<IfModule mod_authz_core.c>
    <FilesMatch "(?i)\.(sql|sql\.gz)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "(?i)\.(sql|sql\.gz)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    # ÊİÚíá ãÍÑß ÅÚÇÏÉ ÇáßÊÇÈÉ
    RewriteEngine On

    # ãáÇÍÙÉ: Êã ÅÒÇáÉ RewriteBase ÇáËÇÈÊ áÌÚá .htaccess ãÍãæáÇğ (portable).
    # íãßä áÜ Apache ÇáÊÚÇãá ãÚ ÇáãÓÇÑÇÊ ÇáäÓÈíÉ Ïæä ÇáÍÇÌÉ Åáì RewriteBase.
    # ÅĞÇ æÇÌåÊ ãÔßáÉ¡ ÃÖİ ÇáÓØÑ ÇáÊÇáí (ÚÏøá ÇáãÓÇÑ ÍÓÈ ÈíÆÊß):
    # RewriteBase /

    # --- ÇáÔÑæØ ---
    # ÇáÔÑØ ÇáÃæá: áÇ ÊØÈŞ ÇáŞÇÚÏÉ ÅĞÇ ßÇä ÇáØáÈ áãáİ ãæÌæÏ
    RewriteCond %{REQUEST_FILENAME} !-f
    # ÇáÔÑØ ÇáËÇäí: áÇ ÊØÈŞ ÇáŞÇÚÏÉ ÅĞÇ ßÇä ÇáØáÈ áãÌáÏ ãæÌæÏ
    RewriteCond %{REQUEST_FILENAME} !-d

    # --- ŞÇÚÏÉ ÇáÊæÌíå ---
    # ÇáÊŞØ Ãí ÔíÁ İí ÇáÑÇÈØ æŞã ÈÊãÑíÑå ßãÊÛíÑ 'url' Åáì public/index.php
    RewriteRule ^(.*)$ public/index.php?url=$1 [QSA,L]
</IfModule>
